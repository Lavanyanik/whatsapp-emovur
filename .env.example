# ===========================================================================
# Emovur Provider (legacy) — required when WHATSAPP_PROVIDER=emovur
# ===========================================================================
EMOVUR_API_URL=https://api.emovur.example.com/v1
API_KEY=YOUR_EMOVUR_API_KEY_HERE
PHONE_NUMBER_ID=YOUR_EMOVUR_PHONE_NUMBER_ID
WABA_ID=YOUR_EMOVUR_WABA_ID
EMOVUR_DRY_RUN=false

# ===========================================================================
# Meta WhatsApp Cloud API — required when WHATSAPP_PROVIDER=meta (default)
# ===========================================================================
# Meta Business App token with 'whatsapp_business_messaging' and
# 'whatsapp_business_management' permissions.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
# Phone-number ID from your WhatsApp Business Account
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# WhatsApp Business Account (WABA) ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Graph API version (defaults to v25.0 if omitted)
GRAPH_API_VERSION=v25.0

# ===========================================================================
# Authentication
# ===========================================================================
# Messages API auth token (used by /messages endpoint; falls back to API_KEY)
MESSAGES_AUTH_TOKEN=your_messages_auth_token_here

# Webhook verify token
VERIFY_TOKEN=your_webhook_verify_token_here

# ===========================================================================
# Scheduling
# ===========================================================================
FOLLOWUP_DELAY_HOURS=24
FINAL_REMINDER_DELAY_HOURS=24
REMINDER_1_TEMPLATE_NAME=candidate_followup_reminder
REMINDER_2_TEMPLATE_NAME=candidate_final_reminder
REMINDER_LANGUAGE=en
SCHEDULER_INTERVAL_SECONDS=60

# ===========================================================================
# Logging
# ===========================================================================
LOG_LEVEL=INFO
