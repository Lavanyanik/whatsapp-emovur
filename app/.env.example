# =============================================================================
# WhatsApp Integration — Environment Configuration Template
# =============================================================================
# 1) Copy this file to .env at the project root
# 2) Fill in your actual values (no quotes around values)
# 3) NEVER commit .env to version control
# =============================================================================

# ── Provider Selection ─────────────────────────────────────────────────────────
# Set to "meta" (default) for direct Meta WhatsApp Cloud API,
# or "emovur" for Emovur aggregator.
WHATSAPP_PROVIDER=meta

# ── Meta WhatsApp Cloud API ────────────────────────────────────────────────────
# These are required when provider is "meta" (default).
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=your_meta_app_secret

# ── Emovur (Meta-compatible aggregator) ────────────────────────────────────────
# These are required only when provider is "emovur".
EMOVUR_API_URL=your_emovur_api_url
API_KEY=your_emovur_api_key
PHONE_NUMBER_ID=your_emovur_phone_number_id
WABA_ID=your_emovur_waba_id

# ── Webhook ────────────────────────────────────────────────────────────────────
VERIFY_TOKEN=your_webhook_verify_token
ENABLE_WEBHOOK_SIGNATURE_VERIFICATION=true

# ── General ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
EMOVUR_DRY_RUN=false

