# Emovur WhatsApp API configuration

# Required by startup (validate_settings)
EMOVUR_API_URL=https://example.invalid/whatsapp
API_KEY=replace-me
PHONE_NUMBER_ID=000000000000000
WABA_ID=000000000000000

# Webhook and auth settings
VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
ENABLE_WEBHOOK_SIGNATURE_VERIFICATION=true
WHATSAPP_PROVIDER=meta
META_API_URL=https://example.invalid/meta
MESSAGES_AUTH_TOKEN=replace-me